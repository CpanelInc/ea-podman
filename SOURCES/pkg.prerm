#!/bin/bash

set -x

# Package removal, not upgrade
if [[ "$1" == "0" || "$1" == "remove" ]]; then
    if [ -x "/opt/cpanel/ea-podman/bin/ea-podman" ]; then
        /opt/cpanel/ea-podman/bin/ea-podman remove_containers --all
        rm -f /opt/cpanel/ea-podman/bin/ea-podman
    fi
    rm -f /opt/cpanel/ea-podman/user-manager-mask.lock
    rm -f /opt/cpanel/ea-podman/user-manager-mask.state

    # Removal only, never an upgrade: leaving an enabled unit behind whose
    # ExecStart is about to be deleted would fail every boot. (EA4-319)
    if [ -d /run/systemd/system ]; then
        systemctl disable --now ea-podman-user-managers.service
    fi
else
    if [ -e "/opt/cpanel/ea-podman/registered-containers.json" ]; then
        # This is an upgrade, we need to preserve /opt/cpanel/ea-podman/registered-containers.json
        if [ -e "/root/.ea-podman-tmp" ]; then
            # remove it just in case it has something we do not want in it
            rm -rf /root/.ea-podman-tmp
        fi

        mkdir -p /root/.ea-podman-tmp
        chmod 0700 /root/.ea-podman-tmp

        # Snapshot under the same lock every mutation uses. Exit 2 means the
        # still-installed (pre-unpack) util.pm predates that helper — fall
        # back to the old plain cp. Any other failure means the locked
        # snapshot itself failed (e.g. contention with a live writer), which
        # a blind cp fallback would risk copying mid-write — fail instead.
        /usr/local/cpanel/3rdparty/bin/perl -e '
            require "/opt/cpanel/ea-podman/lib/ea_podman/util.pm";
            exit 2 if !defined &ea_podman::util::snapshot_known_containers_as_root;
            ea_podman::util::snapshot_known_containers_as_root("/root/.ea-podman-tmp/registered-containers.json");
        '
        rc=$?
        if [ "$rc" = "2" ]; then
            cp -f /opt/cpanel/ea-podman/registered-containers.json /root/.ea-podman-tmp
        elif [ "$rc" != "0" ]; then
            exit 1
        fi
    fi
fi

# Remove the hooks
numhooks=`/usr/local/cpanel/bin/manage_hooks list 2> /dev/null | grep 'hook: PodmanHooks::' | wc -l`
if [ "$numhooks" -ge 1 ]; then
    /usr/local/cpanel/bin/manage_hooks delete module PodmanHooks
fi

