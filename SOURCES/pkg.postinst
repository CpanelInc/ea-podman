#!/bin/bash

set -x

chmod 0700 /opt/cpanel/ea-podman/bin/compile.sh
/opt/cpanel/ea-podman/bin/compile.sh

if [ -f "/usr/local/cpanel/scripts/ea-podman" ]; then
    echo ""
else
    ln -s /opt/cpanel/ea-podman/bin/ea-podman /usr/local/cpanel/scripts/ea-podman
fi

if [ -f "/usr/bin/apt" ]; then
    chmod 0700 /usr/local/cpanel/bin/admin/Cpanel/ea_podman
    chmod 0600 /opt/cpanel/ea-podman/registered-containers.json
fi

if [ -e "/root/.ea-podman-tmp/registered-containers.json" ]; then
    # Merge the pre-upgrade snapshot back in under the same lock, rather than
    # overwriting anything registered since the package installed its fresh
    # registry file. Only clean up the snapshot once that actually worked, so
    # a failed restore leaves it behind for manual recovery instead of
    # silently destroying the only copy.
    if /usr/local/cpanel/3rdparty/bin/perl -e '
        require "/opt/cpanel/ea-podman/lib/ea_podman/util.pm";
        ea_podman::util::restore_known_containers_as_root("/root/.ea-podman-tmp/registered-containers.json");
    '; then
        rm -rf /root/.ea-podman-tmp
    else
        echo "!!!! ea-podman: failed to restore the pre-upgrade container registry; the snapshot is kept at /root/.ea-podman-tmp for manual recovery !!!!" >&2
    fi
fi

# Boot-time sweep that starts the per-user systemd managers rootless podman
# needs. Only load-bearing where `user@.service` is masked (CageFS 7.6.39+ /
# CloudLinux CLOS-4517), where logind cannot start them itself and an account's
# containers would otherwise stay down until its next ea-podman command; a cheap
# no-op everywhere else. Enabled, not started: there is nothing to repair right
# now on a box that has not just rebooted. (EA4-319)
if [ -d /run/systemd/system ] && [ -e /usr/lib/systemd/system/ea-podman-user-managers.service ]; then
    systemctl daemon-reload
    systemctl enable ea-podman-user-managers.service
fi

# Always install the hooks, they are always removed on pre
/usr/local/cpanel/bin/manage_hooks prune; /bin/true;
/usr/local/cpanel/bin/manage_hooks add module PodmanHooks

set +x
echo "!!!! ATTENTION !!"
echo "!!!! If /proc is public it could lead to information disclosure. !!"
echo "Setting /proc to hidepid level 2 is recommended if possible."
echo "As root, run \`ea-podman subids\` and look for more information at the top of the output (if there is no output you are already covered)."
echo "!!!! /ATTENTION !!"
set -x

