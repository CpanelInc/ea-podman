# Committed override of the debify-autogenerated manifest (EA4-319).
# debify regenerates debian/ea-podman.install from the RPM %files on every
# build, and its autogenerated version drops /usr/lib/systemd/system/
# ea-podman-user-managers.service even though %files (165) and the override
# (override_dh_auto_install.sh) both ship it - so the Ubuntu deb installed
# without the unit while the postinst tried to `systemctl enable` it,
# aborting dpkg --configure on every Ubuntu install (v25.82 / 1.0-27).
#
# This file is copied into debian/ AFTER the autogen (debify.pm
# _install_static_debian_files runs after the autogen spew), so it wins.
# Keep it in sync with SPECS/ea-podman.spec %files when the file list changes.
debian/tmp/opt/cpanel/ea-podman/bin/_update-public-hub-to-internal-hub /opt/cpanel/ea-podman/bin
debian/tmp/opt/cpanel/ea-podman/bin/compile.sh /opt/cpanel/ea-podman/bin
debian/tmp/opt/cpanel/ea-podman/bin/ea-podman.pl /opt/cpanel/ea-podman/bin
debian/tmp/opt/cpanel/ea-podman/lib/ea_podman/subids.pm /opt/cpanel/ea-podman/lib/ea_podman
debian/tmp/opt/cpanel/ea-podman/lib/ea_podman/util.pm /opt/cpanel/ea-podman/lib/ea_podman
debian/tmp/opt/cpanel/ea-podman/registered-containers.json /opt/cpanel/ea-podman
debian/tmp/opt/cpanel/ea-podman/webapp-dir-setup /opt/cpanel/ea-podman
debian/tmp/usr/lib/systemd/system/ea-podman-user-managers.service /usr/lib/systemd/system
debian/tmp/usr/local/cpanel/Cpanel/API/EAPodman-cmd.openapi.yaml /usr/local/cpanel/Cpanel/API
debian/tmp/usr/local/cpanel/Cpanel/API/EAPodman-install.openapi.yaml /usr/local/cpanel/Cpanel/API
debian/tmp/usr/local/cpanel/Cpanel/API/EAPodman-list.openapi.yaml /usr/local/cpanel/Cpanel/API
debian/tmp/usr/local/cpanel/Cpanel/API/EAPodman-restart.openapi.yaml /usr/local/cpanel/Cpanel/API
debian/tmp/usr/local/cpanel/Cpanel/API/EAPodman-start.openapi.yaml /usr/local/cpanel/Cpanel/API
debian/tmp/usr/local/cpanel/Cpanel/API/EAPodman-status.openapi.yaml /usr/local/cpanel/Cpanel/API
debian/tmp/usr/local/cpanel/Cpanel/API/EAPodman-stop.openapi.yaml /usr/local/cpanel/Cpanel/API
debian/tmp/usr/local/cpanel/Cpanel/API/EAPodman-uninstall.openapi.yaml /usr/local/cpanel/Cpanel/API
debian/tmp/usr/local/cpanel/Cpanel/API/EAPodman-upgrade.openapi.yaml /usr/local/cpanel/Cpanel/API
debian/tmp/usr/local/cpanel/Cpanel/API/EAPodman.pm /usr/local/cpanel/Cpanel/API
debian/tmp/usr/local/cpanel/bin/admin/Cpanel/ea_podman /usr/local/cpanel/bin/admin/Cpanel
debian/tmp/usr/local/cpanel/bin/admin/Cpanel/ea_podman.conf /usr/local/cpanel/bin/admin/Cpanel
debian/tmp/usr/local/cpanel/install/EAPodman.pm /usr/local/cpanel/install
debian/tmp/var/cpanel/perl5/lib/PodmanHooks.pm /var/cpanel/perl5/lib
